{
  "id": "./",
  "name": "RIANDERBLOG Marketplace",
  "short_name": "RIANDERBLOG",
  "description": "Discover products and shop with suppliers on RIANDERBLOG.",
  "start_url": "./?source=installed-app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f6f9",
  "theme_color": "#173b63",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./app-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./app-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}